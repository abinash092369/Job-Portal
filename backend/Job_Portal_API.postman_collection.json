            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"headline\": \"Senior Full Stack Developer\",\n  \"skills\": [\"TypeScript\", \"React\", \"Node.js\"],\n  \"location\": \"San Francisco, CA\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs?search=Engineer&page=1&limit=9",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "Engineer" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "9" }
              ]
            }
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Frontend Engineer\",\n  \"description\": \"Join our awesome team to build modern React applications.\",\n  \"responsibilities\": \"Develop UI components, optimize performance.\",\n  \"requirements\": \"5+ years experience with React & TypeScript.\",\n  \"skills\": [\"React\", \"TypeScript\", \"TailwindCSS\"],\n  \"salaryRange\": \"$120k - $150k\",\n  \"jobType\": \"full-time\",\n  \"location\": \"San Francisco, CA\",\n  \"experienceLevel\": \"Senior\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] }
          }
        },
        {
          "name": "Apply for Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "coverLetter", "value": "I am excited to apply for this role!", "type": "text" },
                { "key": "resume", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/jobs/{{jobId}}/apply", "host": ["{{baseUrl}}"], "path": ["jobs", "{{jobId}}", "apply"] }
          }
        }
      ]
    },
