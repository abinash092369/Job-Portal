PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/job-portal?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=https://job-portal-abinash.netlify.app
BACKEND_PUBLIC_URL=https://your-backend-railway-url.up.railway.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Job Portal <noreply@jobportal.com>"
